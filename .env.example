# A classic or fine-grained PAT with public_repo scope is enough for probing.
# Read-only work only; nothing in phase 1 writes to GitHub.
SCOUT_GITHUB_TOKEN=ghp_replace_me

# Who you are, so scout can tell "merged a PR from a stranger" from "merged its own".
SCOUT_GITHUB_LOGIN=tp-dev

# Where you are. Used to score maintainer overlap against your actual free hours.
SCOUT_DISPLAY_TZ=Asia/Kolkata
SCOUT_FREE_HOURS_LOCAL=20-24

# Languages you can genuinely ship in, most confident first.
SCOUT_LANGUAGES=Python,Go,TypeScript

# How many pages the prober walks before giving up on covering the 180-day window.
# One page is one rate-limit point. Raise it for very fast repositories.
SCOUT_PROBE_PAGES=4

SCOUT_TIMEOUT_SECONDS=30.0
SCOUT_WATCHLIST_PATH=./watchlist.toml
SCOUT_LOG_LEVEL=info

# Discord channel webhook (Server Settings -> Integrations -> Webhooks -> Copy URL).
# No bot registration needed for notifications - this is a plain POST target.
SCOUT_DISCORD_WEBHOOK_URL=

# Hour (local) the daily digest is sent. Polling runs far more often than this.
SCOUT_DIGEST_HOUR_LOCAL=20
SCOUT_DIGEST_MAX_ITEMS=8

SCOUT_STATE_DIR=./state
SCOUT_EVENTS_DIR=./events

# --- Safety. Every one of these refuses loudly rather than degrading quietly. ---
# Kill switch: false stops poll and digest without touching any schedule.
SCOUT_ENABLED=true
# A watchlist longer than this is a drifted strategy, not a reason for 200 API calls.
SCOUT_MAX_POLL_REPOS=25
# Stop this far short of the rate limit, so an automated run never throttles the token
# and an interactive probe still works afterwards.
SCOUT_RATE_LIMIT_FLOOR=500

# Silence counts as neglect only after this long. Stops a fast repo looking negligent
# just because most of its recent issues are only hours old.
SCOUT_UNANSWERED_AFTER_HOURS=72

# A verdict barely moves week to week, so refresh leaves recent ones alone.
SCOUT_REPROBE_AFTER_DAYS=14
